DATABASE_URL=postgresql://postgres:postgres@localhost:5432/breakingbuns
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Owner access --------------------------------------------------------
# Choose any secret phrase (at least 12 characters). After you create your
# account, open /owner and type this phrase once to become the owner.
OWNER_SETUP_CODE=
# Optional. Where "new order" alert emails are sent.
OWNER_EMAIL=

# --- Emails --------------------------------------------------------------
# Optional. Without a Resend key, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=Breaking Buns <onboarding@resend.dev>

# --- Online payments (Stripe) --------------------------------------------
# Optional. Without these, customers can still order and pay in cash.
# Stripe dashboard -> Developers -> API keys (use the test key while testing).
STRIPE_SECRET_KEY=
# Stripe dashboard -> Developers -> Webhooks. Recommended in production.
STRIPE_WEBHOOK_SECRET=

# --- Performance ---------------------------------------------------------
# Max database connections per server instance (default 10).
# Keep (instances x this value) below your database's connection limit.
DB_POOL_MAX=10
