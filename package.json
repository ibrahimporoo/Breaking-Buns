{
  "name": "breaking-buns",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "user:role": "tsx --env-file=.env.local scripts/set-user-role.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "setup": "npm run db:up && npm run db:push && npm run db:seed",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "loadtest": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.4.2",
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/pg": "^8.11.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "latest"
  }
}
